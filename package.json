{
  "name": "app-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm pascal && vite",
    "dev:be": "pnpm pascal && vite --mode be --port 18080 --strictPort",
    "dev:3d": "pnpm pascal && node scripts/dev-3d.mjs",
    "build": "pnpm pascal && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit && node vendor/pascal/packages/core/node_modules/typescript/bin/tsc --noEmit -p tsconfig.pascal.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pascal": "node scripts/test-pascal.mjs",
    "coverage": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.mjs",
    "length": "node scripts/check-file-length.mjs",
    "draco": "node scripts/copy-draco.mjs",
    "cycles": "node scripts/check-import-cycles.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify-fast.mjs",
    "e2e": "node scripts/run-playwright.mjs --reporter=line",
    "e2e:visual": "node scripts/run-playwright.mjs --update-snapshots --reporter=line",
    "e2e:fullstack": "playwright test -c e2e/fullstack/playwright.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pascal:assets": "node scripts/copy-pascal-assets.mjs",
    "build:pascal": "vite build --config vite.pascal.config.ts",
    "pascal": "node scripts/pascal-cached.mjs",
    "export-pack": "node scripts/export-pack/build.mjs"
  },
  "dependencies": {
    "@pascal-app/core": "workspace:*",
    "@pascal-app/editor": "workspace:*",
    "@pascal-app/nodes": "workspace:*",
    "@pascal-app/viewer": "workspace:*",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "5.53.1",
    "@tanstack/react-virtual": "3.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gsap": "3.15.0",
    "i18next": "23.12.2",
    "lenis": "1.3.26",
    "lucide-react": "0.414.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "6.25.1",
    "tailwind-merge": "^3.6.0",
    "three": "0.186.0",
    "zod": "3.23.8",
    "zundo": "2.1.0",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@playwright/test": "1.45.2",
    "@storybook/addon-a11y": "8.2.5",
    "@storybook/addon-essentials": "8.2.5",
    "@storybook/addon-interactions": "8.2.5",
    "@storybook/addon-links": "8.2.5",
    "@storybook/blocks": "8.2.5",
    "@storybook/react": "8.2.5",
    "@storybook/react-vite": "8.2.5",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.14.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.184.1",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "2.0.3",
    "draco3dgltf": "^1.5.7",
    "eslint": "8.57.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-local": "file:eslint-rules",
    "eslint-plugin-react": "7.34.4",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.8",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "20.14.5",
    "jsdom": "24.1.0",
    "meshoptimizer": "^1.2.0",
    "postcss": "8.4.39",
    "prettier": "3.3.3",
    "sharp": "^0.35.3",
    "storybook": "8.2.5",
    "tailwindcss": "4.3.0",
    "tailwindcss-v4": "npm:tailwindcss@4.3.0",
    "terser": "5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.5.3",
    "vite": "5.3.4",
    "vitest": "2.0.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "@types/three": "0.184.1",
      "@pascal/typescript-config": "workspace:*",
      "@pascal-app/core": "workspace:*",
      "@pascal-app/viewer": "workspace:*",
      "@pascal-app/editor": "workspace:*",
      "@pascal-app/nodes": "workspace:*"
    }
  }
}
